<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>BudgetT – Budgets</title>
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('css/crud.css') }}">
</head>
<body{% if openModal %} data-open-modal="{{ openModal }}"{% endif %}>

    {% include 'partials/nav.html.twig' with {active: 'budgets'} %}

    <!-- Page content -->
    <main class="page">
        <div class="hero">
            <p class="eyebrow">Planning</p>
            <h1>Budgets</h1>
            <p>Plan where your money goes. Swipe a budget left to edit or delete it.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash flash--success" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash flash--error" role="alert">{{ message }}</div>
        {% endfor %}

        <div class="cards">
            <article class="card">
                <p class="card__label">Budget entries</p>
                <p class="card__value">{{ budgets|length }}</p>
            </article>
            <article class="card">
                <p class="card__label">Total budget</p>
                <p class="card__value">{{ totalAmount|money(summaryCurrency) }}</p>
            </article>
            <article class="card">
                <p class="card__label">Average budget</p>
                <p class="card__value">{{ (budgets is empty ? 0 : totalAmount / (budgets|length))|money(summaryCurrency) }}</p>
            </article>
        </div>

        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">All budgets</h2>
                    <p class="panel__sub">Your budgets, newest first. Swipe a card for edit and delete.</p>
                </div>
                <div class="panel__actions">
                    <span class="pill">{{ budgets|length }} {{ budgets|length == 1 ? 'budget' : 'budgets' }}</span>
                    <button type="button" class="add-record-btn" data-bs-toggle="modal" data-bs-target="#createBudgetModal">
                        <span aria-hidden="true">+</span> Add budget
                    </button>
                </div>
            </div>

            {% if budgets is empty %}
                <p class="empty-state">No budgets found in the database yet. Tap “Add budget” to create one.</p>
            {% else %}
                <ul class="swipe-list">
                    {% for budget in budgets %}
                        <li class="swipe-item" data-swipe-item>
                            <div class="swipe-item__actions" data-swipe-actions>
                                <button
                                    type="button"
                                    class="swipe-action swipe-action--edit"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editBudgetModal{{ budget.budgetId }}"
                                    aria-label="Edit {{ budget.description ?? 'budget' }}"
                                >
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                    Edit
                                </button>
                                <form method="post" action="{{ path('budget_delete', {budget: budget.budgetId}) }}" data-confirm="Delete &quot;{{ budget.description ?? 'this budget' }}&quot;? This cannot be undone.">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_budget_' ~ budget.budgetId) }}">
                                    <button type="submit" class="swipe-action swipe-action--delete" aria-label="Delete {{ budget.description ?? 'budget' }}">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>
                                        Delete
                                    </button>
                                </form>
                            </div>
                            <div class="swipe-item__content" data-swipe-content>
                                <div class="swipe-item__main">
                                    <p class="swipe-item__title">{{ budget.description ?? 'Untitled budget' }}</p>
                                    <p class="swipe-item__meta meta-stack">
                                        <span>{{ app.user ? app.user.userIdentifier : '—' }}</span>
                                        <time class="meta-stack__created" datetime="{{ budget.createdAt|date('c') }}">
                                            <span>Created {{ budget.createdAt|date('M j, Y') }}</span>
                                            <span>{{ budget.createdAt|date('g:i A') }}</span>
                                        </time>
                                    </p>
                                </div>
                                <div class="swipe-item__amount-group">
                                    <span class="swipe-item__amount-label">Budget</span>
                                    <p class="swipe-item__amount">{{ budget.amount is null ? '—' : budget.amount|money(budget.currencyType) }}</p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                <p class="swipe-note">Swipe a budget left to reveal edit and delete.</p>
            {% endif %}
        </section>
    </main>

    <button
        type="button"
        class="fab"
        data-bs-toggle="modal"
        data-bs-target="#createBudgetModal"
        aria-label="Add budget"
    >
        <span aria-hidden="true">+</span>
    </button>

    <!-- Create budget modal -->
    <div class="modal fade" id="createBudgetModal" tabindex="-1" aria-labelledby="createBudgetModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="createBudgetModalLabel">Add budget</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(createForm) }}
                    <div class="modal-body">
                        {{ form_errors(createForm) }}
                        {{ form_row(createForm.description, {row_attr: {class: 'form-field'}}) }}
                        {{ form_row(createForm.amount, {row_attr: {class: 'form-field'}}) }}
                        {{ form_row(createForm.currencyType, {row_attr: {class: 'form-field'}}) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save budget</button>
                    </div>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

    <!-- Edit budget modals -->
    {% for budget in budgets %}
        {% set editForm = editForms[budget.budgetId] %}
        <div class="modal fade" id="editBudgetModal{{ budget.budgetId }}" tabindex="-1" aria-labelledby="editBudgetModalLabel{{ budget.budgetId }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="editBudgetModalLabel{{ budget.budgetId }}">Edit budget</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    {{ form_start(editForm) }}
                        <div class="modal-body">
                            {{ form_errors(editForm) }}
                            {{ form_row(editForm.description, {row_attr: {class: 'form-field'}}) }}
                            {{ form_row(editForm.amount, {row_attr: {class: 'form-field'}}) }}
                            {{ form_row(editForm.currencyType, {row_attr: {class: 'form-field'}}) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </div>
                    {{ form_end(editForm) }}
                </div>
            </div>
        </div>
    {% endfor %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="{{ asset('js/home.js') }}"></script>
    <script src="{{ asset('js/crud.js') }}"></script>
</body>
</html>
