<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>BudgetT – Home</title>
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
</head>
<body>

    {% include 'partials/nav.html.twig' with {active: 'dashboard'} %}

    <!-- Page content -->
    <main class="page">
        <section class="hero hero--dashboard">
            <div class="hero__copy">
                <p class="eyebrow">Overview</p>
                <h1>Your money at a glance</h1>
                <p>Track what you have planned, what you have spent, and what is still available.</p>
            </div>
            <div class="hero__actions">
                <a class="btn-action btn-action--primary" href="{{ path('budget') }}">
                    <span aria-hidden="true">+</span> Add budget
                </a>
                <a class="btn-action btn-action--light" href="{{ path('transaction') }}">
                    <span aria-hidden="true">+</span> Add transaction
                </a>
            </div>
        </section>

        {% if uncategorizedSpent > 0 %}
            <p class="dashboard-note">
                <strong>{{ uncategorizedSpent|money }}</strong> of spending is not linked to a budget.
                <a href="{{ path('transaction') }}">Review transactions</a>
            </p>
        {% endif %}

        <div class="cards cards--stats">
            <article class="card stat-card">
                <div class="stat-card__head">
                    <span class="stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><path d="M16 14.5h2"/></svg>
                    </span>
                    <span class="pill">Plan</span>
                </div>
                <p class="card__label">Total budget</p>
                <p class="card__value">{{ totalBudget|money(summaryCurrency) }}</p>
                <p class="card__meta">{{ rows|length }} {{ rows|length == 1 ? 'budget' : 'budgets' }} tracked</p>
            </article>

            <article class="card stat-card">
                <div class="stat-card__head">
                    <span class="stat-card__icon stat-card__icon--spent" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-6M22 19H2"/></svg>
                    </span>
                    <span class="pill">Spending</span>
                </div>
                <p class="card__label">Spent on budgets</p>
                <p class="card__value">{{ totalSpent|money(summaryCurrency) }}</p>
                <p class="card__meta">Linked to your budgets</p>
            </article>

            <article class="card stat-card">
                <div class="stat-card__head">
                    <span class="stat-card__icon stat-card__icon--savings" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v4c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 10v4c0 1.7 3.1 3 7 3s7-1.3 7-3v-4"/></svg>
                    </span>
                    <span class="pill">Savings</span>
                </div>
                <p class="card__label">Remaining savings</p>
                <p class="card__value {{ totalRemaining < 0 ? 'is-negative' : 'is-positive' }}">{{ totalRemaining|money(summaryCurrency) }}</p>
                <p class="card__meta">Budget minus spending</p>
            </article>
        </div>

        <div class="dashboard-grid">
            <section class="panel dashboard-panel">
                <div class="panel__head">
                    <div>
                        <h2 class="panel__title">Budget health</h2>
                        <p class="panel__sub">How much is left in each budget.</p>
                    </div>
                    <a class="text-link" href="{{ path('report') }}">Full report <span aria-hidden="true">→</span></a>
                </div>

                {% if rows is empty %}
                    <p class="empty-state">
                        No budgets yet. <a href="{{ path('budget') }}">Create your first budget</a> to start tracking.
                    </p>
                {% else %}
                    <ul class="health-list">
                        {% for row in rows|slice(0, 4) %}
                            <li class="health-item">
                                <div class="health-item__head">
                                    <div class="health-item__copy">
                                        <p class="health-item__title">{{ row.description }}</p>
                                        <p class="health-item__meta">
                                            {{ row.totalSpent|money(row.currencyType) }} spent
                                        </p>
                                    </div>
                                    <p class="health-item__remaining {{ row.remainingSavings < 0 ? 'is-negative' : 'is-positive' }}">
                                        {{ row.remainingSavings|money(row.currencyType) }}
                                    </p>
                                </div>
                                {% if row.actualBudget > 0 %}
                                    <progress
                                        class="health-item__progress"
                                        value="{{ min(row.totalSpent, row.actualBudget) }}"
                                        max="{{ row.actualBudget }}"
                                        aria-label="Spending against the {{ row.description }} budget"
                                    ></progress>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if rows|length > 4 %}
                        <a class="text-link text-link--block" href="{{ path('report') }}">View all {{ rows|length }} budgets <span aria-hidden="true">→</span></a>
                    {% endif %}
                {% endif %}
            </section>

            <section class="panel dashboard-panel">
                <div class="panel__head">
                    <div>
                        <h2 class="panel__title">Recent transactions</h2>
                        <p class="panel__sub">Your latest spending.</p>
                    </div>
                    <a class="text-link" href="{{ path('transaction') }}">View all <span aria-hidden="true">→</span></a>
                </div>

                {% if recentTransactions is empty %}
                    <p class="empty-state">
                        No transactions yet. <a href="{{ path('transaction') }}">Add your first transaction</a>.
                    </p>
                {% else %}
                    <ul class="recent-list">
                        {% for transaction in recentTransactions %}
                            <li class="recent-item">
                                <span class="recent-item__badge" aria-hidden="true">{{ (transaction.description ?? 'T')|slice(0, 1)|upper }}</span>
                                <div class="recent-item__main">
                                    <p class="recent-item__title">{{ transaction.description ?? 'Untitled transaction' }}</p>
                                    <p class="recent-item__meta meta-stack">
                                        <span>{{ transaction.budget ? (transaction.budget.description ?? 'Untitled budget') : 'Uncategorized' }}</span>
                                        <time class="meta-stack__created" datetime="{{ transaction.createdAt|date('c') }}">
                                            <span>Created {{ transaction.createdAt|date('M j, Y') }}</span>
                                            <span>{{ transaction.createdAt|date('g:i A') }}</span>
                                        </time>
                                    </p>
                                </div>
                                <p class="recent-item__amount">{{ transaction.amount is null ? '—' : transaction.amount|money(transaction.budget ? transaction.budget.currencyType : 'PHP') }}</p>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="{{ asset('js/home.js') }}"></script>
</body>
</html>
