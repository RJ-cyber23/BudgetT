<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#09090b">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>BudgetT – Transactions</title>
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('css/crud.css') }}">
</head>
<body{% if openModal %} data-open-modal="{{ openModal }}"{% endif %}>

    {% include 'partials/nav.html.twig' with {active: 'transactions'} %}

    <!-- Page content -->
    <main class="page">
        <div class="hero">
            <p class="eyebrow">Tracking</p>
            <h1>Transactions</h1>
            <p>Track what you spend. Swipe a transaction left to edit or delete it.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash flash--success" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash flash--error" role="alert">{{ message }}</div>
        {% endfor %}

        <div class="cards">
            <article class="card">
                <p class="card__label">Transactions</p>
                <p class="card__value">{{ transactions|length }}</p>
            </article>
            <article class="card">
                <p class="card__label">Total spent</p>
                <p class="card__value">{{ totalAmount|money(summaryCurrency) }}</p>
            </article>
            <article class="card">
                <p class="card__label">Average spend</p>
                <p class="card__value">{{ (transactions is empty ? 0 : totalAmount / (transactions|length))|money(summaryCurrency) }}</p>
            </article>
        </div>

        <section class="panel">
            <div class="panel__head">
                <div>
                    <h2 class="panel__title">All transactions</h2>
                    <p class="panel__sub">Your spending, newest first. Swipe a card for edit and delete.</p>
                </div>
                <div class="panel__actions">
                    <span class="pill">{{ transactions|length }} {{ transactions|length == 1 ? 'transaction' : 'transactions' }}</span>
                    <button type="button" class="add-record-btn" data-bs-toggle="modal" data-bs-target="#createTransactionModal">
                        <span aria-hidden="true">+</span> Add transaction
                    </button>
                </div>
            </div>

            {% if transactions is empty %}
                <p class="empty-state">No transactions found in the database yet. Tap “Add transaction” to create one.</p>
            {% else %}
                <ul class="swipe-list">
                    {% for transaction in transactions %}
                        <li class="swipe-item" data-swipe-item>
                            <div class="swipe-item__actions" data-swipe-actions>
                                <button
                                    type="button"
                                    class="swipe-action swipe-action--edit"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editTransactionModal{{ transaction.transactionId }}"
                                    aria-label="Edit {{ transaction.description ?? 'transaction' }}"
                                >
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                    Edit
                                </button>
                                <form method="post" action="{{ path('transaction_delete', {transaction: transaction.transactionId}) }}" data-confirm="Delete &quot;{{ transaction.description ?? 'this transaction' }}&quot;? This cannot be undone.">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_transaction_' ~ transaction.transactionId) }}">
                                    <button type="submit" class="swipe-action swipe-action--delete" aria-label="Delete {{ transaction.description ?? 'transaction' }}">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>
                                        Delete
                                    </button>
                                </form>
                            </div>
                            <div class="swipe-item__content" data-swipe-content>
                                <div class="swipe-item__main">
                                    <p class="swipe-item__title">{{ transaction.description ?? 'Untitled transaction' }}</p>
                                    <p class="swipe-item__meta meta-stack">
                                        <span>Budget: {{ transaction.budget ? (transaction.budget.description ?? 'Untitled budget') : 'Uncategorized' }}</span>
                                        <time class="meta-stack__created" datetime="{{ transaction.createdAt|date('c') }}">
                                            <span>Created {{ transaction.createdAt|date('M j, Y') }}</span>
                                            <span>{{ transaction.createdAt|date('g:i A') }}</span>
                                        </time>
                                    </p>
                                </div>
                                <div class="swipe-item__amount-group">
                                    <span class="swipe-item__amount-label">Spent</span>
                                    <p class="swipe-item__amount">{{ transaction.amount is null ? '—' : transaction.amount|money(transaction.budget ? transaction.budget.currencyType : 'PHP') }}</p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                <p class="swipe-note">Swipe a transaction left to reveal edit and delete.</p>
            {% endif %}
        </section>
    </main>

    <button
        type="button"
        class="fab"
        data-bs-toggle="modal"
        data-bs-target="#createTransactionModal"
        aria-label="Add transaction"
    >
        <span aria-hidden="true">+</span>
    </button>

    <!-- Create transaction modal -->
    <div class="modal fade" id="createTransactionModal" tabindex="-1" aria-labelledby="createTransactionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="createTransactionModalLabel">Add transaction</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(createForm) }}
                    <div class="modal-body">
                        {{ form_errors(createForm) }}
                        {{ form_row(createForm.description, {row_attr: {class: 'form-field'}}) }}
                        {{ form_row(createForm.amount, {row_attr: {class: 'form-field'}}) }}
                        {{ form_row(createForm.budget, {row_attr: {class: 'form-field'}}) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save transaction</button>
                    </div>
                {{ form_end(createForm) }}
            </div>
        </div>
    </div>

    <!-- Edit transaction modals -->
    {% for transaction in transactions %}
        {% set editForm = editForms[transaction.transactionId] %}
        <div class="modal fade" id="editTransactionModal{{ transaction.transactionId }}" tabindex="-1" aria-labelledby="editTransactionModalLabel{{ transaction.transactionId }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="editTransactionModalLabel{{ transaction.transactionId }}">Edit transaction</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    {{ form_start(editForm) }}
                        <div class="modal-body">
                            {{ form_errors(editForm) }}
                            {{ form_row(editForm.description, {row_attr: {class: 'form-field'}}) }}
                            {{ form_row(editForm.amount, {row_attr: {class: 'form-field'}}) }}
                            {{ form_row(editForm.budget, {row_attr: {class: 'form-field'}}) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </div>
                    {{ form_end(editForm) }}
                </div>
            </div>
        </div>
    {% endfor %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="{{ asset('js/home.js') }}"></script>
    <script src="{{ asset('js/crud.js') }}"></script>
</body>
</html>
